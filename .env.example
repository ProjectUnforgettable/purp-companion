# Live API base (HTTPS Cloudflare tunnel) — no path suffix. Routes are /api/status and /api/player.
NEXT_PUBLIC_PURP_API_BASE=https://manager-accessibility-rain-quantitative.trycloudflare.com

# Discord OAuth start (Profile "Log in with Discord"). Backend redirects back to /profile?login=1&discordId=…
NEXT_PUBLIC_DISCORD_LOGIN_URL=https://manager-accessibility-rain-quantitative.trycloudflare.com/oauth/discord/start

# Discord — invite is primary for Open Discord buttons
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/your-invite
# Deep link for people already in (e.g. #verify)
NEXT_PUBLIC_DISCORD_OPEN_URL=https://discord.com/channels/GUILD_ID/CHANNEL_ID

# Webhooks (build-time; end up in client JS on static hosting)
NEXT_PUBLIC_DISCORD_WEBHOOK_POLICE=https://discord.com/api/webhooks/...
NEXT_PUBLIC_DISCORD_WEBHOOK_EMS=https://discord.com/api/webhooks/...
NEXT_PUBLIC_DISCORD_WEBHOOK_FIRE=https://discord.com/api/webhooks/...
NEXT_PUBLIC_DISCORD_WEBHOOK_BAN_APPEALS=https://discord.com/api/webhooks/...

# Or point build at a local JSON config (guild/invite/webhooks) instead of listing each var:
# PURP_DISCORD_CONFIG=/path/to/purp-discord-app-config.json
